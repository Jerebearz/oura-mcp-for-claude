# For local testing, copy this file to .dev.vars and also add:
#   ALLOWED_OURA_USER_ID=        (leave empty at first; the login page shows your ID)
#   PUBLIC_BASE_URL=http://localhost:8788
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
TIMEZONE=
